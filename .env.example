# ─── Frontend Open Motors ──────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores

# Google OAuth Client ID (obtener en console.cloud.google.com)
# Crear proyecto → Credenciales → OAuth 2.0 → Tipo: Aplicación web
# Agregar origen autorizado: https://openmotor.vercel.app
VITE_GOOGLE_CLIENT_ID=

# URL base del backend Python FastAPI
# Desarrollo local: NO es necesario definir esta variable (vite.config.ts redirige /api -> localhost:8080)
# Producción en Vercel:
#   VITE_API_URL = https://backend-openmotors.onrender.com/api
VITE_API_URL=http://localhost:8080/api
